* {
    color: #A9B1D6;
    background-color: #1A1B26;
}

window {
    height: 400;
    width: 450;
    border: 0;
    border-radius: 0;
}

mainbox {
    spacing: 0;
    background-color: #1A1B26;
    color: #A9B1D6;
    children: [inputbar, message, listview];
}

inputbar {
    background-color: #1A1B26;
    padding: 15;
}

listview {
    border: 0;
    background-color: #1A1B26;
    padding: 10px;
    dynamic: false;
}

prompt {
    margin: 0 10 0 0;
    background-color: #1A1B26;
}

element {
    padding: 3;
    vertical-align: 0.5;
    border-radius: 0;
    background-color: #1A1B26;
}

element-text.selected.normal, element-icon.selected.normal, element.selected.normal {
    background-color: #202330;
}

element-text, element-icon {
    size: 32;
    margin: 5px;
    color: #A9B1D6;
    background-color: #1A1B26;
    vertical-align: 0.5;
}

